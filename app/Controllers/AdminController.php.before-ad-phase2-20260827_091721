    private function queueServiceNotifications(int $serviceId, string $serviceName): void
    {
        $followers = Database::fetchAll('SELECT f.user_id FROM follows f JOIN users u ON u.id=f.user_id WHERE f.follow_type="service" AND f.follow_id=? AND u.notifications_enabled=1', [$serviceId]);
        foreach ($followers as $f) {
            Database::execute('INSERT INTO notifications(user_id,title,message,link,channel,status,created_at) VALUES(?,?,?,?,?,?,CURRENT_TIMESTAMP)', [(int)$f['user_id'],'تحديث منشور: '.$serviceName,'تم نشر أو اعتماد تحديث متعلق بخدمة تتابعها.','/service/'.(Database::fetch('SELECT slug FROM services WHERE id=?',[$serviceId])['slug']??''),'in_app','sent']);
        }
    }

    public function dashboard(): void
    {
        $this->guard();
        $tableExists = static function(string $name): bool {
            return (bool)Database::fetch("SELECT name FROM sqlite_master WHERE type='table' AND name=? LIMIT 1", [$name]);
        };
        $stats=[
            'published'=>(int)(Database::fetch("SELECT COUNT(*) c FROM services WHERE status='published'")['c']??0),
            'drafts'=>(int)(Database::fetch("SELECT COUNT(*) c FROM services WHERE status='draft'")['c']??0),
            'reports'=>(int)(Database::fetch("SELECT COUNT(*) c FROM trust_reports WHERE status IN ('new','reviewing')")['c']??0),
            'checks'=>(int)(Database::fetch("SELECT COUNT(*) c FROM source_checks WHERE date(checked_at)=date('now')")['c']??0),
            'users'=>(int)(Database::fetch("SELECT COUNT(*) c FROM users WHERE role='user'")['c']??0),
            'source_registry'=>$tableExists('source_registry')?(int)(Database::fetch("SELECT COUNT(*) c FROM source_registry WHERE status='active'")['c']??0):0,
            'verified_x'=>$tableExists('official_x_accounts')?(int)(Database::fetch("SELECT COUNT(DISTINCT target_id) c FROM official_x_accounts WHERE active=1 AND verification_status='verified'")['c']??0):0,
            'incidents'=>$tableExists('live_service_incidents')?(int)(Database::fetch("SELECT COUNT(*) c FROM live_service_incidents WHERE status IN ('confirmed','suspected') AND datetime(expires_at)>datetime('now')")['c']??0):0,
            'ai_drafts'=>(int)(Database::fetch("SELECT COUNT(*) c FROM ai_drafts WHERE status IN ('draft','review')")['c']??0),
        ];
        $recentReports=Database::fetchAll('SELECT tr.*, s.name service_name FROM trust_reports tr JOIN services s ON s.id=tr.service_id ORDER BY tr.created_at DESC LIMIT 6');
        $recentChecks=Database::fetchAll('SELECT sc.*, src.title source_title FROM source_checks sc JOIN sources src ON src.id=sc.source_id ORDER BY sc.checked_at DESC LIMIT 8');
        
$recentIncidents=[];
if($tableExists('live_service_incidents')){
    // v2.0.15: live_service_incidents never had a guaranteed detected_at column.
    // Read the newest available timestamp without breaking older/newer schemas.
    $incidentColumns=array_map(static fn(array $r):string=>(string)($r['name']??''), Database::fetchAll('PRAGMA table_info(live_service_incidents)'));
    $timeColumn=in_array('last_seen_at',$incidentColumns,true)?'last_seen_at':(in_array('first_seen_at',$incidentColumns,true)?'first_seen_at':(in_array('created_at',$incidentColumns,true)?'created_at':null));
    if($timeColumn!==null){
        $recentIncidents=Database::fetchAll("SELECT title,status,confidence,".$timeColumn." AS detected_at,expires_at FROM live_service_incidents WHERE status IN ('confirmed','suspected') AND datetime(expires_at)>datetime('now') ORDER BY ".$timeColumn." DESC LIMIT 5");
    }
}
        View::render('admin/dashboard',['title'=>'لوحة المالك','stats'=>$stats,'recentReports'=>$recentReports,'recentChecks'=>$recentChecks,'recentIncidents'=>$recentIncidents]);
    }


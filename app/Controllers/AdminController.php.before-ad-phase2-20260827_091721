    private function renderService(?int $id): void
    {
        $service=$id?Database::fetch('SELECT * FROM services WHERE id=?',[$id]):null;
        if($id && !$service){http_response_code(404);View::render('errors/404',['title'=>'غير موجود']);return;}
        $categories=Database::fetchAll('SELECT * FROM categories ORDER BY name');
        $sources=Database::fetchAll('SELECT * FROM sources ORDER BY title');
        $steps=$id?Database::fetchAll('SELECT ss.*,src.title source_title FROM service_steps ss LEFT JOIN sources src ON src.id=ss.source_id WHERE ss.service_id=? ORDER BY ss.position',[$id]):[];
        $questions=$id?Database::fetchAll('SELECT pq.*,(SELECT group_concat(label, "، ") FROM path_question_options pqo WHERE pqo.question_id=pq.id ORDER BY pqo.position) options_text FROM path_questions pq WHERE pq.service_id=? ORDER BY pq.position',[$id]):[];
        $rules=$id?Database::fetchAll('SELECT pr.*,ss.title step_title FROM path_rules pr JOIN service_steps ss ON ss.id=pr.step_id WHERE pr.service_id=? ORDER BY pr.id',[$id]):[];
        View::render('admin/service_edit',['title'=>$service?'تعديل '.$service['name']:'إضافة خدمة','service'=>$service,'categories'=>$categories,'sources'=>$sources,'steps'=>$steps,'questions'=>$questions,'rules'=>$rules]);
    }

    public function serviceSave(): void
    {
        $this->guard(); Csrf::verify();
        $id=(int)($_POST['id']??0); $name=trim((string)($_POST['name']??'')); $slug=trim((string)($_POST['slug']??'')); if($slug==='')$slug=\slugify($name);
        if($name===''||$slug===''){\flash('error','اسم الخدمة والرابط المختصر مطلوبان.');\redirect($id?'admin/service/'.$id:'admin/service/new');}
        $data=[
            (int)($_POST['category_id']??0)?:null,$name,$slug,trim((string)($_POST['official_entity']??'')),trim((string)($_POST['summary']??'')),trim((string)($_POST['beneficiaries']??'')),trim((string)($_POST['eligibility']??'')),trim((string)($_POST['requirements']??'')),trim((string)($_POST['notes']??'')),trim((string)($_POST['official_url']??'')),trim((string)($_POST['official_platform']??'')),(string)($_POST['status']??'draft'),isset($_POST['indexable'])?1:0,trim((string)($_POST['seo_title']??'')),trim((string)($_POST['seo_description']??''))
        ];
        $requestedStatus = $data[11];
        $data[11] = 'draft';
        if($id){
            Database::execute('UPDATE services SET category_id=?,name=?,slug=?,official_entity=?,summary=?,beneficiaries=?,eligibility=?,requirements=?,notes=?,official_url=?,official_platform=?,status=?,indexable=?,seo_title=?,seo_description=?,updated_at=CURRENT_TIMESTAMP WHERE id=?',array_merge($data,[$id]));
        } else {
            Database::execute('INSERT INTO services(category_id,name,slug,official_entity,summary,beneficiaries,eligibility,requirements,notes,official_url,official_platform,status,indexable,seo_title,seo_description,created_at,updated_at) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,CURRENT_TIMESTAMP,CURRENT_TIMESTAMP)',$data);
            $id=Database::lastInsertId();
        }
        if($requestedStatus === 'published') {
            $errors = (new PublishGuard())->validateService($id);
            if($errors) {
                \flash('error', 'حارس النشر منع النشر: ' . implode(' | ', array_slice($errors,0,4)));
            } else {
                Database::execute('UPDATE services SET status="published",published_at=COALESCE(published_at,CURRENT_TIMESTAMP),updated_at=CURRENT_TIMESTAMP WHERE id=?',[$id]);
                $this->queueServiceNotifications($id,$name);
                \flash('success','تم حفظ الخدمة ونشرها بعد اجتياز حارس النشر.');
                \redirect('admin/service/'.$id);
            }
        }
        \flash('success','تم حفظ الخدمة كمسودة.'); \redirect('admin/service/'.$id);
    }


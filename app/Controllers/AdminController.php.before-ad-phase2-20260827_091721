    private function uploadUiImage(string $field, string $prefix): ?string
    {
        if(!isset($_FILES[$field]) || !is_array($_FILES[$field]) || (int)($_FILES[$field]['error']??UPLOAD_ERR_NO_FILE)===UPLOAD_ERR_NO_FILE) return null;
        $file=$_FILES[$field]; if((int)$file['error']!==UPLOAD_ERR_OK){\flash('error','تعذر رفع الصورة.');return null;}
        if((int)$file['size']>2*1024*1024){\flash('error','حجم الصورة يتجاوز 2MB.');return null;}
        $tmp=(string)$file['tmp_name']; $mime=(new \finfo(FILEINFO_MIME_TYPE))->file($tmp) ?: '';
        $ext=['image/png'=>'png','image/jpeg'=>'jpg','image/webp'=>'webp'][$mime]??null; if($ext===null){\flash('error','صيغة الصورة غير مدعومة. استخدم PNG أو JPG أو WebP.');return null;}
        $name=$prefix.'-'.date('YmdHis').'-'.bin2hex(random_bytes(3)).'.'.$ext; $relative='assets/uploads/'.$name;
        $projectTarget=\root_path('public/'.$relative); @mkdir(dirname($projectTarget),0755,true);
        $domainRoot=dirname(\root_path()); $deployedTarget=$domainRoot.'/public_html/'.$relative; @mkdir(dirname($deployedTarget),0755,true);
        if(!move_uploaded_file($tmp,$projectTarget)){\flash('error','تعذر حفظ الصورة على الخادم.');return null;}
        if(is_dir(dirname($deployedTarget))) @copy($projectTarget,$deployedTarget);
        return $relative;
    }

    private function uploadUiMedia(string $field, string $prefix): ?array
    {
        if(!isset($_FILES[$field]) || !is_array($_FILES[$field]) || (int)($_FILES[$field]['error']??UPLOAD_ERR_NO_FILE)===UPLOAD_ERR_NO_FILE) return null;
        $file=$_FILES[$field]; if((int)$file['error']!==UPLOAD_ERR_OK){\flash('error','تعذر رفع ملف البانر.');return null;}
        $tmp=(string)$file['tmp_name']; $mime=(new \finfo(FILEINFO_MIME_TYPE))->file($tmp) ?: '';
        $imageMap=['image/png'=>'png','image/jpeg'=>'jpg','image/webp'=>'webp'];
        $videoMap=['video/mp4'=>'mp4','video/webm'=>'webm'];
        $type=null; $ext=null; $limit=0;
        if(isset($imageMap[$mime])){$type='image';$ext=$imageMap[$mime];$limit=4*1024*1024;}
        elseif(isset($videoMap[$mime])){$type='video';$ext=$videoMap[$mime];$limit=25*1024*1024;}
        if($type===null){\flash('error','صيغة البانر غير مدعومة. استخدم PNG/JPG/WebP أو MP4/WebM.');return null;}
        if((int)$file['size']>$limit){\flash('error',$type==='video'?'حجم الفيديو يتجاوز 25MB.':'حجم الصورة يتجاوز 4MB.');return null;}
        $name=$prefix.'-'.date('YmdHis').'-'.bin2hex(random_bytes(3)).'.'.$ext; $relative='assets/uploads/'.$name;
        $projectTarget=\root_path('public/'.$relative); @mkdir(dirname($projectTarget),0755,true);
        $domainRoot=dirname(\root_path()); $deployedTarget=$domainRoot.'/public_html/'.$relative; @mkdir(dirname($deployedTarget),0755,true);
        if(!move_uploaded_file($tmp,$projectTarget)){\flash('error','تعذر حفظ ملف البانر على الخادم.');return null;}
        if(is_dir(dirname($deployedTarget))) @copy($projectTarget,$deployedTarget);
        return ['path'=>$relative,'type'=>$type];
    }

    public function analytics(): void
    {
        $this->guard();
        $period=(string)($_GET['period']??'30'); if(!in_array($period,['7','30','90'],true))$period='30';
        $days=(int)$period; $modifier='-'.$days.' days';
        $stats=['pageviews'=>0,'sessions'=>0,'ad_impressions'=>0,'ad_clicks'=>0,'ctr'=>0.0];
        try {
            $stats['pageviews']=(int)(Database::fetch("SELECT COUNT(*) c FROM traffic_events WHERE event_type='pageview' AND created_at>=datetime('now',?)",[$modifier])['c']??0);
            $stats['sessions']=(int)(Database::fetch("SELECT COUNT(DISTINCT session_hash) c FROM traffic_events WHERE event_type='pageview' AND created_at>=datetime('now',?)",[$modifier])['c']??0);
            $sources=Database::fetchAll("SELECT source_category label,COUNT(*) total FROM traffic_events WHERE event_type='pageview' AND created_at>=datetime('now',?) GROUP BY source_category ORDER BY total DESC LIMIT 8",[$modifier]);
            $devices=Database::fetchAll("SELECT device_type label,COUNT(*) total FROM traffic_events WHERE event_type='pageview' AND created_at>=datetime('now',?) GROUP BY device_type ORDER BY total DESC",[$modifier]);
            $pages=Database::fetchAll("SELECT page_path label,COUNT(*) total FROM traffic_events WHERE event_type='pageview' AND created_at>=datetime('now',?) GROUP BY page_path ORDER BY total DESC LIMIT 10",[$modifier]);
            $daily=Database::fetchAll("SELECT date(created_at) day,COUNT(*) total FROM traffic_events WHERE event_type='pageview' AND created_at>=datetime('now',?) GROUP BY date(created_at) ORDER BY day",[$modifier]);
        } catch (\Throwable) { $sources=$devices=$pages=$daily=[]; }
        try {
            $ad=Database::fetch("SELECT SUM(event_type='impression') imp,SUM(event_type='click') clk FROM ad_experiment_events WHERE created_at>=datetime('now',?)",[$modifier])?:[];
            $stats['ad_impressions']=(int)($ad['imp']??0); $stats['ad_clicks']=(int)($ad['clk']??0);
            $stats['ctr']=$stats['ad_impressions']>0?round(($stats['ad_clicks']/$stats['ad_impressions'])*100,2):0.0;
            $experiments=Database::fetchAll("SELECT x.id,x.name,x.placement,x.status,COALESCE(SUM(e.event_type='impression'),0) impressions,COALESCE(SUM(e.event_type='click'),0) clicks FROM ad_experiments x LEFT JOIN ad_experiment_events e ON e.experiment_id=x.id AND e.created_at>=datetime('now',?) GROUP BY x.id ORDER BY impressions DESC,x.id DESC LIMIT 12",[$modifier]);
        } catch (\Throwable) { $experiments=[]; }
        View::render('admin/analytics',['title'=>'تحليلات الإعلانات والزيارات','period'=>$period,'stats'=>$stats,'sources'=>$sources,'devices'=>$devices,'pages'=>$pages,'daily'=>$daily,'experiments'=>$experiments]);
    }


        if ($draftId > 0) Database::execute('UPDATE ai_drafts SET status="draft" WHERE id=?', [$draftId]);
        \flash('success', 'تم حذف المقال. وإذا كان مصدره مسودة AI فقد أعيدت المسودة إلى حالة قابلة للمراجعة.');
        \redirect('admin/content');
    }

}

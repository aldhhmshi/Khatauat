    public function articleSave(): void
    {
        $this->guard();
        Csrf::verify();

        $id = (int) ($_POST['id'] ?? 0);
        $title = trim((string) ($_POST['title'] ?? ''));
        $slug = trim((string) ($_POST['slug'] ?? '')) ?: \slugify($title);
        $status = (string) ($_POST['status'] ?? 'draft');
        if (!in_array($status, ['draft', 'published'], true)) $status = 'draft';

        if ($title === '' || $slug === '') {
            \flash('error', 'العنوان والرابط المختصر مطلوبان.');
            \redirect('admin/content' . ($id ? '?edit=' . $id : ''));
        }

        $duplicate = Database::fetch('SELECT id FROM articles WHERE slug=? AND id<>? LIMIT 1', [$slug, $id]);
        if ($duplicate) {
            \flash('error', 'الرابط المختصر مستخدم في مقال آخر.');
            \redirect('admin/content' . ($id ? '?edit=' . $id : ''));
        }

        $sourceUrls = ArticleDraftMapper::normalizeUrls((string) ($_POST['source_urls'] ?? ''));
        $sourceUrlsText = implode("\n", $sourceUrls);
        $verified = isset($_POST['sources_verified']);
        $verificationNotes = trim((string) ($_POST['verification_notes'] ?? ''));

        if ($status === 'published' && (!$verified || $sourceUrls === [])) {
            \flash('error', 'لا يمكن نشر المقال قبل إرفاق مصدر رسمي واحد على الأقل وتأكيد مراجعة المصادر.');
            \redirect('admin/content' . ($id ? '?edit=' . $id : ''));
        }

        $values = [
            $title,
            $slug,
            trim((string) ($_POST['summary'] ?? '')),
            ArticleDraftMapper::sanitizeHtml((string) ($_POST['content'] ?? '')),
            trim((string) ($_POST['seo_title'] ?? '')),
            trim((string) ($_POST['seo_description'] ?? '')),
            $sourceUrlsText,
            $verificationNotes,
            $verified ? date('Y-m-d H:i:s') : null,
            $verified ? (string) (Auth::user()['name'] ?? 'owner') : null,
            $status,
        ];

        if ($id > 0) {
            Database::execute('UPDATE articles SET title=?,slug=?,summary=?,content=?,seo_title=?,seo_description=?,source_urls=?,verification_notes=?,verified_at=?,verified_by=?,status=?,published_at=CASE WHEN ?="published" THEN COALESCE(published_at,CURRENT_TIMESTAMP) ELSE NULL END,updated_at=CURRENT_TIMESTAMP WHERE id=?', array_merge($values, [$status, $id]));
            \flash('success', 'تم تحديث المقال.');
            \redirect('admin/content?edit=' . $id);
        }

        Database::execute('INSERT INTO articles(title,slug,summary,content,seo_title,seo_description,source_urls,verification_notes,verified_at,verified_by,status,published_at,created_at,updated_at) VALUES(?,?,?,?,?,?,?,?,?,?,?,CASE WHEN ?="published" THEN CURRENT_TIMESTAMP ELSE NULL END,CURRENT_TIMESTAMP,CURRENT_TIMESTAMP)', array_merge($values, [$status]));
        \flash('success', 'تم حفظ المقال.');
        \redirect('admin/content');
    }

